{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amazon-ai-coo.local/schemas/decision_rule.schema.json",
  "title": "DecisionRule",
  "type": "object",
  "required": [
    "id",
    "status",
    "preconditions",
    "signals",
    "candidate_action",
    "risk"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_action": {
      "type": "string"
    },
    "expected_effect": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "reversible": {
      "type": "boolean"
    },
    "approval_required": {
      "type": "boolean"
    },
    "measurement_window_days": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}